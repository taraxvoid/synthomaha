#!/bin/sh
bun run format && git diff --cached --name-only --diff-filter=d | xargs -r git add

# test/build.test.ts asserts against dist/, which isn't guaranteed to exist
# pre-commit (test:unit alone doesn't build) — skip it here; CI's `test`
# script builds first and runs it there.
bun run test:unit -- --exclude 'test/build.test.ts'

if git diff --cached --name-only | grep -qE '(^|/)(package\.json|bun\.lock)$'; then
  bun run check:licenses
fi
