# Hosts lychee cannot meaningfully check. Lychee only sees status codes, not
# response bodies, so it cannot detect a private/deleted account behind a 200.

# Login-walled — these return 200 (or a bot challenge) regardless of whether the
# linked profile still exists, so a "pass" here means nothing.
https?://([^/]+\.)*facebook\.com(/|$)
https?://([^/]+\.)*fb\.com(/|$)
https?://([^/]+\.)*instagram\.com(/|$)
https?://([^/]+\.)*linkedin\.com(/|$)
https?://([^/]+\.)*x\.com(/|$)
https?://([^/]+\.)*twitter\.com(/|$)
https?://([^/]+\.)*tiktok\.com(/|$)

# Aggressive rate limiting / bot filtering on musician streaming + booking links.
https?://([^/]+\.)*bandcamp\.com(/|$)
https?://([^/]+\.)*soundcloud\.com(/|$)
https?://([^/]+\.)*spotify\.com(/|$)
https?://([^/]+\.)*eventbrite\.com(/|$)

# Netlify form POST target — not a fetchable page.
https?://([^/]+\.)*netlify\.app/__forms\.html
