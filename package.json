{
    "name": "synthomaha.net",
    "type": "module",
    "version": "0.1.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "astro": "astro",
        "prepare": "husky",
        "generate:logo": "bun run scripts/generate-logo-png.ts",
        "generate:favicons": "bun run scripts/generate-favicons.mjs",
        "generate": "bun run generate:logo && bun run generate:favicons",
        "check": "astro check",
        "check:content": "astro sync",
        "format": "biome check --write .",
        "lint": "biome check .",
        "test": "bun run test:unit",
        "test:unit": "bun test test/*.test.js",
        "test:ical": "bun test test/ical.test.js",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@astrojs/react": "6.0.0",
        "@astrojs/sitemap": "^3.7.3",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/orbitron": "^5.2.8",
        "@netlify/blobs": "^10.7.9",
        "@netlify/functions": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.2",
        "astro": "^7.0.7",
        "blobshape": "^1.0.0",
        "favicons": "^7.3.0",
        "marked": "^17.0.6",
        "marked-shiki": "^1.2.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "rrule": "^2.8.1",
        "tailwindcss": "^4.3.2",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@biomejs/biome": "2.5.1",
        "@playwright/test": "^1.61.1",
        "@types/blobshape": "^1.0.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "husky": "^9.1.7",
        "typescript": "^6.0.3"
    },
    "volta": {
        "node": "24.15.0"
    }
