{
    "name": "synthomaha.net",
    "type": "module",
    "version": "0.1.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "stop": "astro dev stop",
        "build": "bun scripts/build.mjs",
        "preview": "astro preview",
        "astro": "astro",
        "prepare": "husky",
        "generate:logo": "bun run scripts/generate-logo-png.ts",
        "generate:favicons": "bun run scripts/generate-favicons.mjs",
        "generate": "bun run generate:logo && bun run generate:favicons",
        "compress:images": "bun scripts/compress-images.ts",
        "check": "astro check",
        "check:content": "astro sync",
        "format": "biome check --write .",
        "lint": "biome check .",
        "test": "bun run build && npm-run-all -l -p check test:unit -s test:e2e:only",
        "test:unit": "vitest run",
        "test:e2e:only": "playwright test --project=mobile-chrome",
        "test:fast": "run-p -l lint test:data",
        "test:ical": "vitest run test/ical.test.ts",
        "test:data": "vitest run test/data.test.ts",
        "test:build": "vitest run test/build.test.ts",
        "test:e2e": "bun run build && playwright test --project=mobile-chrome",
        "test:e2e:desktop": "bun run build && playwright test --project=desktop-chrome",
        "test:e2e:all": "bun run build && playwright test",
        "test:e2e:ui": "playwright test --ui",
        "postinstall": "bunx @biomejs/biome migrate --write",
        "test:e2e:headed": "playwright test --headed"
    },
    "dependencies": {
        "@astrojs/react": "6.0.0",
        "@astrojs/sitemap": "^3.7.3",
        "@awesome.me/webawesome": "^3.11.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/orbitron": "^5.3.0",
        "@netlify/blobs": "^10.7.13",
        "@netlify/functions": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.2",
        "blobshape": "^1.0.0",
        "favicons": "^7.3.1",
        "marked": "^18.0.9",
        "marked-shiki": "^1.2.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rrule": "^2.8.1",
        "tailwindcss": "^4.3.3",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@biomejs/biome": "^2.5.8",
        "@playwright/test": "^1.62.1",
        "@types/blobshape": "^1.0.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "husky": "^9.1.7",
        "npm-run-all2": "^9.0.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "volta": {
        "node": "24.15.0"
    }
}
