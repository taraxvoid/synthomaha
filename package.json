{
    "name": "synthomaha.net",
    "type": "module",
    "version": "0.1.1",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "astro": "astro",
        "prepare": "husky",
        "generate:logo": "bun run scripts/generate-logo-png.ts",
        "generate:favicons": "bun run scripts/generate-favicons.mjs",
        "generate": "bun run generate:logo && bun run generate:favicons",
        "check": "astro check",
        "check:content": "astro sync",
        "format": "biome check --write .",
        "lint": "biome check .",
        "test": "bun run test:unit && playwright test",
        "test:unit": "bun test test/data.test.js test/eventVisibility.test.js test/ical.test.js && bun test test/build.test.js",
        "test:data": "bun test test/data.test.js",
        "test:build": "bun test test/build.test.js",
        "test:ical": "bun test test/ical.test.js",
        "test:fast": "bun run lint && bun run test:data",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed"
    },
    "dependencies": {
        "@astrojs/react": "5.0.6",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/orbitron": "^5.2.8",
        "@netlify/blobs": "^10.7.9",
        "@netlify/functions": "^5.3.0",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.3.1",
        "astro": "6.4.6",
        "blobshape": "^1.0.0",
        "favicons": "^7.3.0",
        "marked": "^17.0.6",
        "marked-shiki": "^1.2.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwindcss": "^4.3.1",
        "unique-names-generator": "^4.7.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@biomejs/biome": "^2.5.0",
        "@playwright/test": "^1.61.0",
        "@types/blobshape": "^1.0.3",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "husky": "^9.1.7",
        "typescript": "^6.0.3"
    },
    "volta": {
        "node": "24.15.0"
    }
}
