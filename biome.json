{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "extends": ["@taraxvoid/voidflow/biome"],
    "formatter": {
        "includes": [
            "**",
            "!**/bun.lock",
            "!**/deno.lock",
            "!**/.husky/",
            "!public/admin/**"
        ]
    },
    "linter": {
        "includes": ["**", "!.astro/**", "!public/admin/**", "!public/**/*.svg"]
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
