---
import { getCollection } from 'astro:content'
import BookingForm from '../components/BookingForm'
import EmailSignupForm from '../components/EmailSignupForm'
import EventCalendar from '../components/EventCalendar.astro'
import MusicianProfiles from '../components/MusicianProfiles.astro'
import PatchCable from '../components/PatchCable.astro'
import Layout from '../layouts/Layout.astro'

const allMusicians = await getCollection('musicians')
const visibleMusicians = allMusicians
    .filter((m) => !m.data.hidden)
    .map((m) => ({ name: m.data.name }))
---

<Layout title="SynthOmaha - Electronic / Modular / Ambient / Experimental">
    <!-- Hidden static forms for Netlify Forms detection at build time -->
    <form name="signup" data-netlify="true" hidden>
        <input type="email" name="email" />
    </form>
    <form name="booking" data-netlify="true" hidden>
        <input type="text" name="name" />
        <input type="email" name="email" />
        <input type="text" name="musician" />
        <textarea name="venue"></textarea>
        <textarea name="additional_info"></textarea>
    </form>

    <!-- Patch bay spine — one cable connecting every section, plugged in at each heading -->
    <div class="relative pl-8 sm:pl-10">
        <PatchCable
            orientation="vertical"
            class="absolute left-[0.6rem] top-2 bottom-2 w-2 -z-10 sm:left-[0.85rem]"
        />

        <!-- About Section -->
        <section class="relative py-6 mb-4">
            <span class="jack jack--signal absolute -left-8 top-1.5 sm:-left-10" aria-hidden="true"></span>
            <h2 class="text-3xl font-bold mb-6 text-signal">Synth Omaha - Electronic Music in the Midwest</h2>

            <div class="space-y-4 text-inherit">
                <p>
                    Open Jam on the Last Monday of the month at <strong>Shakedown Street Bar in Benson</strong> @ 8:00 PM Central Time
                </p>
            </div>
        </section>

        <!-- Event Calendar -->
        <section class="relative mb-4" id="events">
            <span class="jack absolute -left-8 top-1.5 sm:-left-10" aria-hidden="true"></span>
            <EventCalendar />
        </section>

        <!-- Musician Profiles -->
        <section class="relative mb-4" id="musicians">
            <span class="jack absolute -left-8 top-1.5 sm:-left-10" aria-hidden="true"></span>
            <MusicianProfiles />
        </section>

        <!-- Subscribe / Follow -->
        <section class="relative py-6 mb-4" id="signup">
            <span class="jack jack--signal absolute -left-8 top-1.5 sm:-left-10" aria-hidden="true"></span>
            <h2 class="text-2xl font-bold mb-4 text-signal">Stay Connected</h2>
            <p class="text-inherit mb-6">Get notified of upcoming events and gigs</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-signal">Email Updates</h3>
                    <EmailSignupForm client:load />
                </div>
                <div>
                    <h3 class="text-lg font-semibold mb-3 text-signal">Calendar</h3>
                    <p class="mb-4 text-sm">Add our events directly to your calendar app</p>
                    <a
                        href="https://calendar.google.com/calendar/r?cid=webcal%3A%2F%2Fsynthomaha.net%2Fevents.ics"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn no-underline"
                    >
                        <wa-icon name="calendar" aria-hidden="true"></wa-icon> Subscribe to Calendar
                    </a>
                </div>
            </div>
        </section>

        <!-- Booking -->
        <section class="relative py-6 mb-4" id="contact">
            <span class="jack absolute -left-8 top-1.5 sm:-left-10" aria-hidden="true"></span>
            <h2 class="text-2xl font-bold mb-4 text-signal">Booking</h2>
            <BookingForm client:load musicians={visibleMusicians} />
        </section>
    </div></Layout
>
