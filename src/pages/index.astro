---
import Layout from '../layouts/Layout.astro';
import EventCalendar from '../components/EventCalendar.astro';
import EmailSignupForm from '../components/EmailSignupForm';
import BookingForm from '../components/BookingForm';
---

<Layout title="SynthOmaha - Omaha's Electronic Music Meetup">
    <!-- Hidden static forms for Netlify Forms detection at build time -->
    <form name="signup" data-netlify="true" hidden>
        <input type="email" name="email" />
    </form>
    <form name="booking" data-netlify="true" hidden>
        <input type="text" name="name" />
        <input type="email" name="email" />
        <input type="text" name="subject" />
        <textarea name="message"></textarea>
    </form>

    <!-- About Section -->
    <section class="py-6 mb-4 border-t border-b border-primary/50">
        <h2 class="text-3xl font-bold mb-6 text-primary">About Synthomaha</h2>

        <div class="space-y-4 text-inherit">
            <p>
                Last Monday of the month at <strong>Shakedown Street Bar in Benson</strong> starting at 8PM<br />

                Performing is <em>entirely</em> optional and wallflowers are celebrated.
            </p>
        </div>
    </section>

    <!-- Event Calendar -->
    <section class="mb-4" id="calendar">
        <EventCalendar />
    </section>

    <!-- Email Signup -->
    <section class="py-6 mb-4 border-t border-primary/50" id="signup">
        <h2 class="text-2xl font-bold mb-4 text-primary">Stay in the Loop</h2>
        <p class="text-inherit mb-6">Get notified about upcoming events and news.</p>
        <EmailSignupForm client:load />
    </section>

    <!-- Contact / Booking -->
    <section class="py-6 mb-4 border-t border-primary/50" id="contact">
        <h2 class="text-2xl font-bold mb-4 text-primary">Book or Contact Us</h2>
        <p class="text-inherit mb-6">Interested in performing, booking, or just want to say hi?</p>
        <BookingForm client:load />
    </section>
</Layout>
