---
import { getCollection } from 'astro:content';
import BookingForm from '../components/BookingForm';
import EmailSignupForm from '../components/EmailSignupForm';
import EventCalendar from '../components/EventCalendar.astro';
import MusicianProfiles from '../components/MusicianProfiles.astro';
import Layout from '../layouts/Layout.astro';

const allMusicians = await getCollection('musicians');
const visibleMusicians = allMusicians.filter((m) => !m.data.hidden).map((m) => ({ name: m.data.name }));
---

<Layout title="SynthOmaha - Electronic / Modular / Ambient / Experimental">
    <!-- Hidden static forms for Netlify Forms detection at build time -->
    <form name="signup" data-netlify="true" hidden>
        <input type="email" name="email" />
    </form>
    <form name="booking" data-netlify="true" hidden>
        <input type="text" name="name" />
        <input type="email" name="email" />
        <input type="text" name="musician" />
        <textarea name="venue"></textarea>
        <textarea name="additional_info"></textarea>
    </form>

    <!-- About Section -->
    <section class="py-6 mb-4 border-t border-b border-primary/50">
        <h2 class="text-3xl font-bold mb-6 text-primary">Synth Omaha - Electronic Music in the Midwest</h2>

        <div class="space-y-4 text-inherit">
            <p>
                Open Jam on the Last Monday of the month at <strong>Shakedown Street Bar in Benson</strong> @ 8:00 PM Central Time
            </p>
        </div>

        <div class="flex flex-wrap gap-3 mt-6">
            <a href="#events" class="btn no-underline">See Upcoming Events</a>
            <a href="#stay-connected" class="no-underline inline-flex items-center justify-center gap-2 cursor-pointer text-center font-semibold transition-colors border border-primary/60 text-primary hover:bg-primary/10 rounded px-5 py-3.5 text-sm">Get Notified</a>
        </div>
    </section>

    <!-- Event Calendar -->
    <section class="mb-4" id="events">
        <EventCalendar />
    </section>

    <!-- Musician Profiles -->
    <section class="mb-4 border-t border-primary/50 pt-6" id="musicians">
        <MusicianProfiles />
    </section>

    <!-- Stay Connected -->
    <section class="py-6 mb-4 border-t border-primary/50" id="stay-connected">
        <h2 class="text-2xl font-bold mb-4 text-primary">Stay Connected</h2>
        <p class="text-inherit mb-6">Get notified of upcoming events and gigs</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            <div>
                <h3 class="text-lg font-semibold mb-3 text-primary">Email Updates</h3>
                <EmailSignupForm client:load />
            </div>
            <div>
                <h3 class="text-lg font-semibold mb-3 text-primary">Calendar</h3>
                <p class="mb-4 text-sm">Add our events directly to your calendar app</p>
                <a
                    href="https://calendar.google.com/calendar/r?cid=webcal%3A%2F%2Fsynthomaha.net%2Fevents.ics"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn no-underline"
                >
                    <wa-icon name="calendar" aria-hidden="true"></wa-icon> Subscribe to Calendar
                </a>
            </div>
        </div>
    </section>

    <!-- Booking -->
    <section class="py-6 mb-4 border-t border-primary/50" id="contact">
        <h2 class="text-2xl font-bold mb-4 text-primary">Booking</h2>
        <BookingForm client:load musicians={visibleMusicians} />
    </section></Layout
>
