---
import { getCollection } from 'astro:content'
import BookingForm from '../components/BookingForm'
import EmailSignupForm from '../components/EmailSignupForm'
import EventCalendar from '../components/EventCalendar.astro'
import MusicianProfiles from '../components/MusicianProfiles.astro'
import Layout from '../layouts/Layout.astro'
import { jackColorClass } from '../utils/jackColors'

const allMusicians = await getCollection('musicians')
const visibleMusicians = allMusicians
    .filter((m) => !m.data.hidden)
    .map((m) => ({ name: m.data.name }))
---

<Layout title="SynthOmaha - Electronic / Modular / Ambient / Experimental">
    <!-- Hidden static forms for Netlify Forms detection at build time -->
    <form name="signup" data-netlify="true" hidden>
        <input type="email" name="email" />
    </form>
    <form name="booking" data-netlify="true" hidden>
        <input type="text" name="name" />
        <input type="email" name="email" />
        <input type="tel" name="phone" />
        <input type="text" name="musician" />
        <textarea name="venue"></textarea>
        <input type="date" name="event_date" />
        <textarea name="additional_info"></textarea>
    </form>

    <!-- About Section -->
    <section class="py-6 mb-4">
        <div class="flex items-center gap-3 mb-6">
            <span class={`jack ${jackColorClass(0)}`} aria-hidden="true"></span>
            <h2 class="text-3xl font-bold">Omaha's Electronic Music Meetup</h2>
        </div>

        <div class="space-y-4 text-inherit">
            <p>
                Open Jam on the Last Monday of the month at <strong>Shakedown Street Bar in Benson</strong> @ 8:00 PM Central Time
            </p>
        </div>
    </section>

    <!-- Event Calendar -->
    <section class="mb-4" id="events">
        <div class="flex items-center gap-3 mb-6">
            <span class={`jack ${jackColorClass(1)}`} aria-hidden="true"></span>
            <h2 class="text-3xl font-bold">Upcoming Events</h2>
        </div>
        <EventCalendar />
    </section>

    <!-- Musician Profiles -->
    <section class="mb-4" id="musicians">
        <div class="flex items-center gap-3 mb-6">
            <span class={`jack ${jackColorClass(2)}`} aria-hidden="true"></span>
            <h2 class="text-3xl font-bold">Musicians</h2>
        </div>
        <MusicianProfiles />
    </section>

    <!-- Subscribe / Follow -->
    <section class="py-6 " id="signup">
        <div class="flex items-center gap-3 mb-4">
            <span class={`jack ${jackColorClass(3)}`} aria-hidden="true"></span>
            <h2 class="text-2xl font-bold">Stay Connected</h2>
        </div>

        <EmailSignupForm client:load />
    </section>

    <!-- Booking -->
    <section class="py-6" id="contact">
        <div class="flex items-center gap-3 mb-4">
            <span class={`jack ${jackColorClass(4)}`} aria-hidden="true"></span>
            <h2 class="text-2xl font-bold">Book A Musician</h2>
        </div>
        <BookingForm client:load musicians={visibleMusicians} />
    </section></Layout
>
