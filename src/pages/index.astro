---
import { getCollection } from 'astro:content'

const allMusicians = await getCollection('musicians')
const _visibleMusicians = allMusicians
  .filter((m) => !m.data.hidden)
  .map((m) => ({ name: m.data.name }))
---

<Layout title="SynthOmaha - Electronic / Modular / Ambient / Experimental">
    <!-- Hidden static forms for Netlify Forms detection at build time -->
    <form name="signup" data-netlify="true" hidden>
        <input type="email" name="email" />
    </form>
    <form name="booking" data-netlify="true" hidden>
        <input type="text" name="name" />
        <input type="email" name="email" />
        <input type="text" name="subject" />
        <input type="text" name="musician" />
        <textarea name="message"></textarea>
    </form>

    <!-- About Section -->
    <section class="py-6 mb-4 border-t border-b border-primary/50">
        <h2 class="text-3xl font-bold mb-6 text-primary">Monthly Meetup Last Mondays at Shakedown Street in Benson</h2>

        <div class="space-y-4 text-lg opacity-80">
            <p>
                Hang out with fellow synth enthusiasts at the <strong>SynthOmaha Open Jam</strong> on the Last Monday of the month at
                <a href="https://www.facebook.com/shakedownstreettavern" target="_blank" rel="noopener noreferrer"> Shakedown Street Bar in Benson </a>
                @ 8:00 PM Central Time. Performing optional.
            </p>
        </div>
    </section>

    <!-- Event Calendar -->
    <section class="mb-4" id="calendar">
        <EventCalendar />
    </section>

    <!-- Musician Profiles -->
    <section class="mb-4 border-t border-primary/50 pt-6" id="musicians">
        <MusicianProfiles />
    </section>

    <!-- Email Signup -->
    <section class="py-4 mb-4 border-t border-primary/50" id="signup">
        <h2 class="text font-bold mb-4 text-primary">Email List Signup</h2>
        <EmailSignupForm client:load />
    </section>

    <!-- Booking -->
    <section class="py-4 mb-4 border-t border-primary/50" id="contact">
        <h2 class="text font-bold mb-4 text-primary">Send Booking Request</h2>

        <BookingForm client:load musicians={visibleMusicians} />
    </section></Layout
>
