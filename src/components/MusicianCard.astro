---
interface Props {
  name: string
  bio?: string
  profileImage?: string
  bandcamp?: string
  soundcloud?: string
  instagram?: string
  website?: string
}

const { name, bio, profileImage, bandcamp, soundcloud, instagram, website } =
  Astro.props

const instagramUrl = instagram
  ? `https://instagram.com/${instagram.replace(/^@/, '')}`
  : null

const _links = [
  bandcamp && { href: bandcamp, label: 'Bandcamp' },
  soundcloud && { href: soundcloud, label: 'SoundCloud' },
  instagramUrl && { href: instagramUrl, label: 'Instagram' },
  website && { href: website, label: 'Website' },
].filter(Boolean) as { href: string; label: string }[]

const _imageUrl = profileImage || '/images/logo.png'
const _isLogoFallback = !profileImage
---

<wa-card class="musician-card">
    <div class="flex gap-3">
        <img
            src={imageUrl}
            alt={name}
            class:list={[
                'w-6 h-6 rounded-ee-md object-cover border shrink-0 mt-0.5',
                isLogoFallback ? 'bg-white/5 p-1 border-primary/20' : 'border-primary/30'
            ]}
            onerror="this.src='/images/logo.png'; this.classList.add('bg-white/5', 'p-1', 'border-primary/20'); this.classList.remove('border-primary/30')"
        />
        <div>
            <div class="text-lg font-semibold text-primary">{name}</div>
            {bio && <div class="text-lg opacity-70 mt-0.5 leading-normal">{bio}</div>}
            {
                links.length > 0 && (
                    <div class="flex flex-wrap gap-x-1 gap-y-0.5 mt-1.5 text-lg opacity-90">
                        {links.map((link) => (
                            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-primary">
                                {link.label}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</wa-card>
