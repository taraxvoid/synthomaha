---
interface Props {
    name: string;
    bio?: string;
    profileImage?: string;
    bandcamp?: string;
    soundcloud?: string;
    instagram?: string;
    website?: string;
}

const { name, bio, profileImage, bandcamp, soundcloud, instagram, website } = Astro.props;

const instagramUrl = instagram ? `https://instagram.com/${instagram.replace(/^@/, '')}` : null;

const links = [
    bandcamp && { href: bandcamp, label: 'Bandcamp' },
    soundcloud && { href: soundcloud, label: 'SoundCloud' },
    instagramUrl && { href: instagramUrl, label: 'Instagram' },
    website && { href: website, label: 'Website' }
].filter(Boolean) as { href: string; label: string }[];
---

<wa-card class="musician-card">
    <div class="flex gap-3">
        {
            profileImage ? (
                <img src={profileImage} alt={name} class="w-8 h-8 rounded-full object-cover border border-primary/30 shrink-0 mt-0.5" />
            ) : (
                <div class="w-8 h-8 rounded-full bg-white/5 border border-primary/20 shrink-0 mt-0.5 flex items-center justify-center">
                    <svg class="w-4 h-4 opacity-20" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                    </svg>
                </div>
            )
        }
        <div>
            <div class="text-sm font-semibold text-primary">{name}</div>
            {bio && <div class="text-xs opacity-70 mt-0.5 leading-snug">{bio}</div>}
            {
                links.length > 0 && (
                    <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5 text-xs">
                        {links.map((link) => (
                            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-primary">
                                {link.label}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</wa-card>
