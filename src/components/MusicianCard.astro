---
interface Props {
    name: string
    bio?: string
    profileImage?: string
    bandcamp?: string
    soundcloud?: string
    instagram?: string
    website?: string
}

const { name, bio, profileImage, bandcamp, soundcloud, instagram, website } =
    Astro.props

const instagramUrl = instagram
    ? `https://instagram.com/${instagram.replace(/^@/, '')}`
    : null

const links = [
    bandcamp && { href: bandcamp, label: 'Bandcamp' },
    soundcloud && { href: soundcloud, label: 'SoundCloud' },
    instagramUrl && { href: instagramUrl, label: 'Instagram' },
    website && { href: website, label: 'Website' },
].filter(Boolean) as { href: string; label: string }[]

const imageUrl = profileImage || '/images/logo.png'
const isLogoFallback = !profileImage
---

<wa-card class="musician-card">
    <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
        <img
            src={imageUrl}
            alt={name}
            width={48}
            height={56}
            loading="lazy"
            decoding="async"
            class:list={['w-12 h-14 sm:w-10 sm:h-12 rounded-md object-cover border shrink-0', isLogoFallback ? 'bg-white/5 p-1 border-signal/20' : 'border-signal/30']}
            onerror="this.src='/images/logo.png'; this.classList.add('bg-white/5', 'p-1', 'border-signal/20'); this.classList.remove('border-signal/30')"
        />
        <div class="min-w-0">
            <div class="text-sm font-semibold text-ink-bright">{name}</div>
            {bio && <div class="text-xs opacity-70 mt-0.5 leading-snug">{bio}</div>}
            {
                links.length > 0 && (
                    <div class="flex flex-wrap gap-x-3 gap-y-0.5 mt-1.5 text-xs">
                        {links.map((link) => (
                            <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-signal">
                                {link.label}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </div>
</wa-card>
