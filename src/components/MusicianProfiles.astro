---
import { getCollection } from 'astro:content'

const allMusicians = await getCollection('musicians')
const _musicians = allMusicians.filter((m) => !m.data.hidden)
---

<section class="py-4">
    <h2 class="text-3xl font-bold mb-6 text-primary">Resident Musicians</h2>

    {
        musicians.length === 0 ? (
            <p class="opacity-60">Musician profiles coming soon.</p>
        ) : (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {musicians.map((musician) => (
                    <MusicianCard
                        name={musician.data.name}
                        bio={musician.data.bio}
                        profileImage={musician.data.profileImage}
                        bandcamp={musician.data.bandcamp}
                        soundcloud={musician.data.soundcloud}
                        instagram={musician.data.instagram}
                        website={musician.data.website}
                    />
                ))}
            </div>
        )
    }
</section>
