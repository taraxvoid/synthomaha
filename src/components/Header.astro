---
import Logo from '../components/Logo.astro'
import { jackColorClass } from '../utils/jackColors'

const navItems = [
    { linkText: 'Events', href: '#events' },
    { linkText: 'Musicians', href: '#musicians' },
    { linkText: 'Booking', href: '#contact' },
    { linkText: 'Join the List', href: '#signup', isCta: true },
]
---

<nav class="flex flex-wrap items-center gap-4 pt-6 pb-4 sm:pt-12 sm:pb-6 border-b border-signal/20">
    <a href="/">
        <Logo />
    </a>
    {
        !!navItems?.length && (
            <ul class="flex flex-wrap items-center gap-x-3 gap-y-3">
                {navItems.map((item, index) => (
                    <li class="flex items-center gap-1.5">
                        <span
                            class:list={['jack', jackColorClass(index)]}
                            aria-hidden="true"
                        />
                        <a
                            href={item.href}
                            class:list={[
                                'no-underline inline-block px-3 py-1.5 text-sm font-semibold tracking-wide uppercase rounded transition-colors',
                                item.isCta
                                    ? 'bg-signal text-signal-content border border-signal hover:bg-signal/85'
                                    : 'border border-signal/60 bg-panel-raised/60 text-signal shadow-[inset_0_1px_0_rgba(255,255,255,0.08),inset_0_-2px_0_rgba(0,0,0,0.4)] hover:bg-signal hover:text-signal-content hover:border-signal',
                            ]}
                        >
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
