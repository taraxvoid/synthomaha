---
import Logo from '../components/Logo.astro'
import { jackColorClass } from '../utils/jackColors'

const navItems = [
    { linkText: 'Events', href: '#events' },
    { linkText: 'Musicians', href: '#musicians' },
    { linkText: 'Booking', href: '#contact' },
    { linkText: 'Join The Club', href: '#signup', isCta: true },
]
---

<nav class="flex flex-wrap items-center gap-4 pt-6 pb-4 sm:pt-12 sm:pb-6 border-b border-signal/20">
    <a href="/" class="relative inline-flex mt-2 sm:mt-3 p-3">
        <span class="pointer-events-none absolute left-0 top-0 h-3 w-3 border-l-2 border-t-2 border-signal/70" aria-hidden="true" />
        <span class="pointer-events-none absolute right-0 top-0 h-3 w-3 border-r-2 border-t-2 border-signal/70" aria-hidden="true" />
        <span class="pointer-events-none absolute left-0 bottom-0 h-3 w-3 border-l-2 border-b-2 border-signal/70" aria-hidden="true" />
        <span class="pointer-events-none absolute right-0 bottom-0 h-3 w-3 border-r-2 border-b-2 border-signal/70" aria-hidden="true" />
        <Logo />
    </a>
    {
        !!navItems?.length && (
            <ul class="grid grid-cols-2 gap-x-3 gap-y-3 sm:flex sm:flex-wrap sm:items-center sm:mt-3">
                {navItems.map((item, index) => (
                    <li class="flex items-center gap-1.5">
                        <span
                            class:list={['jack', jackColorClass(index)]}
                            aria-hidden="true"
                        />
                        <a
                            href={item.href}
                            class:list={[
                                'no-underline inline-block w-full text-center px-4 py-2.5 text-base font-semibold tracking-wide uppercase rounded transition-colors sm:w-auto',
                                item.isCta
                                    ? 'bg-signal text-signal-content border border-signal hover:bg-signal/85'
                                    : 'border border-signal/60 bg-panel-raised/60 text-signal shadow-[inset_0_1px_0_rgba(255,255,255,0.08),inset_0_-2px_0_rgba(0,0,0,0.4)] hover:bg-signal hover:text-signal-content hover:border-signal',
                            ]}
                        >
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
</nav>
