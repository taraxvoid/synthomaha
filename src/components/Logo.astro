<!--
  Logo: "Omaha" — O is a roughly circular oval with 6 evenly spaced gray
  patch jacks connected by alternating purple and pink cables bowing outward.
  Center (21,22), rx=16 ry=15. Jacks at 0°/60°/120°/180°/240°/300° from top.
-->
<svg width="152" height="44" viewBox="0 0 152 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="SynthOmaha">

  <!-- Jack coords: J0(21,7) J1(35,15) J2(35,30) J3(21,37) J4(7,30) J5(7,15) -->

  <!-- Cables: alternating purple / pink, bowing outward -->
  <path d="M21,7  Q32,5  35,15" stroke="#9333ea" stroke-width="2.3" stroke-linecap="round" fill="none"/>
  <path d="M35,15 Q42,23 35,30" stroke="#db2777" stroke-width="2.3" stroke-linecap="round" fill="none"/>
  <path d="M35,30 Q32,40 21,37" stroke="#9333ea" stroke-width="2.3" stroke-linecap="round" fill="none"/>
  <path d="M21,37 Q10,40  7,30" stroke="#db2777" stroke-width="2.3" stroke-linecap="round" fill="none"/>
  <path d="M7,30  Q0,23   7,15" stroke="#9333ea" stroke-width="2.3" stroke-linecap="round" fill="none"/>
  <path d="M7,15  Q10,5  21,7"  stroke="#db2777" stroke-width="2.3" stroke-linecap="round" fill="none"/>

  <!-- Jack sockets (gray, visible against dark panel) -->
  <circle cx="21" cy="7"  r="3.2" fill="#8c8880"/>
  <circle cx="35" cy="15" r="3.2" fill="#8c8880"/>
  <circle cx="35" cy="30" r="3.2" fill="#8c8880"/>
  <circle cx="21" cy="37" r="3.2" fill="#8c8880"/>
  <circle cx="7"  cy="30" r="3.2" fill="#8c8880"/>
  <circle cx="7"  cy="15" r="3.2" fill="#8c8880"/>

  <!-- Jack holes -->
  <circle cx="21" cy="7"  r="1.3" fill="#1a1816"/>
  <circle cx="35" cy="15" r="1.3" fill="#1a1816"/>
  <circle cx="35" cy="30" r="1.3" fill="#1a1816"/>
  <circle cx="21" cy="37" r="1.3" fill="#1a1816"/>
  <circle cx="7"  cy="30" r="1.3" fill="#1a1816"/>
  <circle cx="7"  cy="15" r="1.3" fill="#1a1816"/>

  <!-- "MAHA" text — Orbitron for synth/manufacturer caps styling -->
  <text
    x="50"
    y="30"
    font-family="'Orbitron Variable', 'Orbitron', ui-sans-serif, sans-serif"
    font-size="22"
    font-weight="700"
    letter-spacing="2"
    fill="#ddd8cc"
  >MAHA</text>

</svg>
