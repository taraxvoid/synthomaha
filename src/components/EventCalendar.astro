---
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const todayStr = new Date().toISOString().split('T')[0];
const upcomingEvents = allEvents.filter((e) => e.data.date >= todayStr).sort((a, b) => a.data.date.localeCompare(b.data.date));

const formatDate = (dateStr: string) => {
    // Append noon to avoid timezone-shift on date-only strings
    const date = new Date(dateStr + 'T12:00:00');
    return date.toLocaleDateString('en-US', {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
};

const formatTime = (time: string) => {
    const [hours, minutes] = time.split(':');
    const hour = parseInt(hours);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const displayHour = hour > 12 ? hour - 12 : hour === 0 ? 12 : hour;
    return `${displayHour}:${minutes} ${ampm}`;
};
---

<section class="py-4">
    <h2 class="text-3xl font-bold mb-6 text-primary">Event Calendar</h2>

    {
        upcomingEvents.length === 0 ? (
            <p class="opacity-60">No upcoming events — check back soon.</p>
        ) : (
            <div class="space-y-4">
                {upcomingEvents.map((event) => (
                    <wa-card class="event-card">
                        <div slot="header">
                            <h3 class="text-xl font-semibold text-primary">{event.data.title}</h3>
                        </div>
                        <div>
                            {event.data.image && <img src={event.data.image} alt={event.data.title} class="w-full rounded mb-4 object-cover max-h-48" />}
                            <p class="opacity-80 mb-4">{event.data.description}</p>
                            <div class="space-y-2 text-sm">
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M8 7V3m8 4V3m-9 8h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                        />
                                    </svg>
                                    <span>{formatDate(event.data.date)}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    <span>{formatTime(event.data.time)}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                        />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    <span>{event.data.location}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                        />
                                    </svg>
                                    <span>{event.data.price === '0' ? 'Free' : `$${event.data.price}`}</span>
                                </div>
                            </div>
                        </div>
                        <div slot="footer" class="flex items-center gap-3">
                            <a
                                href={`/events/${event.id}.ics`}
                                download
                                class="btn no-underline"
                                style="--btn-py: 0.5rem; --btn-px: 1rem; --btn-font-size: 0.8rem;"
                            >
                                📅 Add to Calendar
                            </a>
                        </div>
                    </wa-card>
                ))}
            </div>
        )
    }

    <p class="mt-6 text-sm opacity-50">
        <a href="/events.ics" class="underline hover:opacity-80">Subscribe to all events in Google Calendar</a>
    </p>
</section>
