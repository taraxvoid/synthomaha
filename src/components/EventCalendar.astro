---
import { getCollection } from 'astro:content'

const allEvents = await getCollection('events')
const sortedEvents = allEvents.sort((a, b) =>
    a.data.date.localeCompare(b.data.date),
)

const formatDate = (dateStr: string) => {
    const date = new Date(`${dateStr}T12:00:00`)
    return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    })
}

const formatTime = (time: string) => {
    const [hours, minutes] = time.split(':')
    const hour = parseInt(hours, 10)
    const ampm = hour >= 12 ? 'PM' : 'AM'
    const displayHour = hour > 12 ? hour - 12 : hour === 0 ? 12 : hour
    return `${displayHour}:${minutes} ${ampm}`
}
---

<section class="py-4">
    <h2 class="text-3xl font-bold mb-6 text-signal">Upcoming Events</h2>

    <p class="opacity-60" id="no-events-message" hidden>
        No upcoming events —{' '}
        <a href="#signup" class="underline">
            Subscribe to Email List
        </a>{' '}
        to be notified of new events!
    </p>

    {
        sortedEvents.length > 0 && (
            <div class="space-y-3" id="events-list">
                {sortedEvents.map((event) => (
                    <wa-card data-event-date={event.data.date}>
                        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                            {event.data.image && (
                                <img
                                    src={event.data.image}
                                    alt={event.data.title}
                                    class="w-full sm:w-16 rounded object-cover shrink-0"
                                    style="max-height: 8rem;"
                                />
                            )}
                            <div class="grow min-w-0">
                                <div class="flex flex-wrap items-start justify-between gap-1 mb-1">
                                    <h3 class="text-lg font-semibold text-signal leading-tight">{event.data.title}</h3>
                                    <a
                                        href={`/events/${event.id}.ics`}
                                        class="btn shrink-0 no-underline"
                                        style="--btn-py: 0.6rem; --btn-px: 1rem; --btn-font-size: 0.75rem;"
                                    >
                                        <wa-icon name="calendar" aria-hidden="true"></wa-icon> Add To Calendar
                                    </a>
                                </div>
                                <p class="text-lg opacity-75 mb-1">{event.data.description}</p>
                                <div class="flex flex-wrap gap-x-1 gap-y-1 text-inherit">
                                    <span><wa-icon name="calendar" aria-hidden="true"></wa-icon> {formatDate(event.data.date)}</span>
                                    <span><wa-icon name="clock" aria-hidden="true"></wa-icon> {formatTime(event.data.time)}</span>
                                    <span><wa-icon name="location-dot" aria-hidden="true"></wa-icon> {event.data.location}</span>
                                    <span><wa-icon name="ticket" aria-hidden="true"></wa-icon> {event.data.price === '0' ? 'Free' : `$${event.data.price}`}</span>
                                </div>
                            </div>
                        </div>
                    </wa-card>
                ))}
            </div>
        )
    }
</section>

<script>
    import { isEventPast } from '../utils/eventVisibility';

    const todayStr = new Date().toISOString().split('T')[0];
    const list = document.getElementById('events-list');
    const noEventsMessage = document.getElementById('no-events-message');

    let visibleCount = 0;
    for (const card of list?.querySelectorAll('[data-event-date]') ?? []) {
        const isPast = isEventPast(card.getAttribute('data-event-date') ?? '', todayStr);
        card.toggleAttribute('hidden', isPast);
        if (!isPast) visibleCount++;
    }

    noEventsMessage?.toggleAttribute('hidden', visibleCount > 0);
</script>

<style>
    wa-card[hidden] {
        display: none !important;
    }
</style>
