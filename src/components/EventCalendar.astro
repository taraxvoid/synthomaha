---
import { getCollection } from 'astro:content'
import { getNextOccurrence } from '../utils/recurrence'

const allEvents = await getCollection('events')
const displayEvents = allEvents.map((event) => {
    if (!event.data.recurrence) {
        return {
            event,
            displayDate: event.data.date,
            displayTime: event.data.time,
        }
    }
    const next = getNextOccurrence(
        event.data.date,
        event.data.time,
        event.data.recurrence,
    )
    return {
        event,
        displayDate: next?.date ?? event.data.date,
        displayTime: next?.time ?? event.data.time,
    }
})
const sortedEvents = displayEvents.sort((a, b) =>
    a.displayDate.localeCompare(b.displayDate),
)

const formatDate = (dateStr: string) => {
    const date = new Date(`${dateStr}T12:00:00`)
    return date.toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    })
}

const formatTime = (time: string) => {
    const [hours, minutes] = time.split(':')
    const hour = parseInt(hours, 10)
    const ampm = hour >= 12 ? 'PM' : 'AM'
    const displayHour = hour > 12 ? hour - 12 : hour === 0 ? 12 : hour
    return `${displayHour}:${minutes} ${ampm}`
}

const mapsUrl = (location: string) =>
    `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`
---

<Fragment>
    <p class="opacity-60" id="no-events-message" hidden>
        No upcoming events 
    </p>

    {
        sortedEvents.length > 0 && (
            <div class="space-y-3 sm:w-[calc((100%-0.75rem)/2)]" id="events-list">
                {sortedEvents.map(({ event, displayDate, displayTime }) => (
                    <wa-card data-event-date={displayDate}>
                        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                            {event.data.image && (
                                <img
                                    src={event.data.image}
                                    alt={event.data.title}
                                    class="w-full h-48 sm:w-40 sm:h-40 rounded object-cover shrink-0"
                                />
                            )}
                            <div class="grow min-w-0">
                                <h3 class="text-xl font-semibold leading-tight mb-1">{event.data.title}</h3>
                                <p class="text-base opacity-75 mb-3">{event.data.description}</p>
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-inherit mb-3">
                                    <span class="inline-flex items-center gap-1">
                                        <wa-icon name="calendar" aria-hidden="true"></wa-icon>
                                        {formatDate(displayDate)} &middot; {formatTime(displayTime)}
                                    </span>
                                    <span class="opacity-50" aria-hidden="true">&bull;</span>
                                    <a
                                        href={mapsUrl(event.data.location)}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="underline hover:opacity-80"
                                    >
                                        {event.data.location}
                                    </a>
                                    <span class="opacity-50" aria-hidden="true">&bull;</span>
                                    <span>{event.data.price === '0' ? 'Free' : `$${event.data.price}`}</span>
                                </div>
                                <a
                                    href={`/events/${event.id}.ics`}
                                    class="btn no-underline"
                                    style="--btn-py: 0.5rem; --btn-px: 0.85rem; --btn-font-size: 0.7rem;"
                                >
                                    <wa-icon name="calendar" aria-hidden="true"></wa-icon> Add To Calendar
                                </a>
                            </div>
                        </div>
                    </wa-card>
                ))}
            </div>
        )
    }
</Fragment>

<script>
    import { isEventPast } from '../utils/eventVisibility';

    const todayStr = new Date().toISOString().split('T')[0];
    const list = document.getElementById('events-list');
    const noEventsMessage = document.getElementById('no-events-message');

    let visibleCount = 0;
    for (const card of list?.querySelectorAll('[data-event-date]') ?? []) {
        const isPast = isEventPast(card.getAttribute('data-event-date') ?? '', todayStr);
        card.toggleAttribute('hidden', isPast);
        if (!isPast) visibleCount++;
    }

    noEventsMessage?.toggleAttribute('hidden', visibleCount > 0);
</script>

<style>
    wa-card[hidden] {
        display: none !important;
    }
</style>
